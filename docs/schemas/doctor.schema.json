{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/doctor.schema.json",
  "title": "doctor report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "doctor" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "schema_version", "capabilities", "rpc_transport", "networks"],
      "properties": {
        "tool": { "const": "stellar-contract-platform" },
        "version": { "type": "string" },
        "schema_version": { "const": "1.0" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "rpc_transport": { "type": "string" },
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passphrase", "default_rpc_url"],
            "properties": {
              "name": { "type": "string" },
              "passphrase": { "type": "string" },
              "default_rpc_url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
