{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/repro.dependencies.schema.json",
  "title": "repro.dependencies report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "repro.dependencies" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "comparison"],
      "properties": {
        "dependencies": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": ["string", "null"] }
            }
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "compared_dependencies", "differences", "detail"],
          "properties": {
            "state": { "enum": ["unavailable", "match", "mismatch"] },
            "compared_dependencies": { "type": "integer", "minimum": 0 },
            "differences": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "left", "right"],
                "properties": {
                  "name": { "type": "string" },
                  "left": { "type": ["string", "null"] },
                  "right": { "type": ["string", "null"] }
                }
              }
            },
            "detail": { "type": "string" }
          }
        }
      }
    }
  }
}
