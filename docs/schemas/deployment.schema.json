{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/deployment.schema.json",
  "title": "deployment report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "deployment" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "wasm_hash", "last_modified_ledger_seq", "live_until_ledger_seq", "found"],
      "properties": {
        "contract_id": { "type": "string" },
        "wasm_hash": { "type": ["string", "null"] },
        "last_modified_ledger_seq": { "type": ["integer", "null"], "minimum": 0 },
        "live_until_ledger_seq": { "type": ["integer", "null"], "minimum": 0 },
        "found": { "type": "boolean" }
      }
    }
  }
}
