{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tech-Cred/stellar-contract-platform/blob/main/docs/schemas/version.schema.json",
  "title": "version report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "tool", "version", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "version" },
    "tool": { "const": "stellar-contract-platform" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "schema_version", "api_version"],
      "properties": {
        "tool": { "const": "stellar-contract-platform" },
        "version": { "type": "string" },
        "schema_version": { "const": "1.0" },
        "api_version": { "const": "v1" }
      }
    }
  }
}
